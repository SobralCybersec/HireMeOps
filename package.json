{
  "name": "hiremeops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev -f real-browser",
    "app:build": "tauri build -f real-browser",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:mjs",
    "test:unit": "vitest run",
    "test:mjs": "node --test scripts/*.node-test.mjs",
    "format": "prettier --write src scripts/check-file-size.mjs scripts/jscpd.mjs scripts/quality-review.mjs scripts/benchmark-changes.mjs scripts/benchmark-changes-metrics.mjs scripts/*.node-test.mjs",
    "format:check": "prettier --check src scripts/check-file-size.mjs scripts/jscpd.mjs scripts/quality-review.mjs scripts/benchmark-changes.mjs scripts/benchmark-changes-metrics.mjs scripts/*.node-test.mjs",
    "prepare:playwright": "node ./scripts/prepare-tauri-playwright-resources.mjs",
    "benchmark:changes": "node scripts/benchmark-changes.mjs",
    "headless-test": "node automation/headless-test.mjs",
    "build:docker": "docker build -f docker/Dockerfile.worker -t hiremeops-worker:latest .",
    "build:docker:slim": "docker build -f docker/Dockerfile.worker.slim -t hiremeops-worker:latest .",
    "build:linux": "NO_STRIP=true tauri build -f real-browser",
    "build:linux:portable": "bash scripts/build-linux.sh --tar",
    "build:windows": "bash scripts/build-windows.sh",
    "quality:review": "node scripts/quality-review.mjs",
    "quality:strict": "node scripts/quality-review.mjs --strict",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run quality:review"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/calistoga": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "animejs": "^4.5.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "patchright": "1.62.3",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jscpd": "^5.1.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
