{
  "name": "hiremeops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev -f real-browser",
    "app:build": "tauri build -f real-browser",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:mjs && bun run agent:smoke",
    "test:unit": "vitest run",
    "test:mjs": "node scripts/benchmark/*.node-test.mjs",
    "test:strict-tests": "node scripts/quality/strict-tests/*.node-test.mjs",
    "format": "prettier --write src scripts/quality/check-file-size.mjs scripts/quality/jscpd.mjs scripts/quality/quality-review.mjs scripts/benchmark/benchmark-changes.mjs scripts/benchmark/benchmark-changes-metrics.mjs scripts/benchmark/*.node-test.mjs agent",
    "format:check": "prettier --check src scripts/quality/check-file-size.mjs scripts/quality/jscpd.mjs scripts/quality/quality-review.mjs scripts/benchmark/benchmark-changes.mjs scripts/benchmark/benchmark-changes-metrics.mjs scripts/benchmark/*.node-test.mjs agent",
    "agent:typecheck": "tsc --noEmit -p agent/tsconfig.json",
    "agent:smoke": "bun agent/tests/smoke.ts",
    "agent:exa-smoke": "bun agent/tests/exa-smoke.ts",
    "prepare:playwright": "node ./scripts/build/prepare-tauri-playwright-resources.mjs",
    "benchmark:changes": "node scripts/benchmark/benchmark-changes.mjs",
    "headless-test": "node automation/tests/live/headless-test.mjs",
    "build:docker": "docker build -f docker/Dockerfile.worker -t hiremeops-worker:latest .",
    "build:docker:slim": "docker build -f docker/Dockerfile.worker.slim -t hiremeops-worker:latest .",
    "build:linux": "NO_STRIP=true tauri build -f real-browser",
    "build:linux:portable": "bash scripts/build/build-linux.sh --tar",
    "build:windows": "bash scripts/build/build-windows.sh",
    "quality:review": "node scripts/quality/quality-review.mjs",
    "quality:strict-tests": "node scripts/quality/strict-tests/quality-review.mjs --strict --require-tools",
    "quality:strict": "bun run quality:strict-tests",
    "verify": "bun run typecheck && bun run agent:typecheck && bun run lint && bun run format:check && bun run test && bun run test:strict-tests && bun run quality:review && bun run quality:strict-tests"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.46",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/calistoga": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "ai": "7.0.97",
    "animejs": "^4.5.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "patchright": "1.62.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
