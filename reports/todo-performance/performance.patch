+        system: Some(cover_letter_system(language)),
+        input_hash: input_hash(&[
+            COVER_LETTER_PROMPT_VERSION,
+            language.code(),
+            target_title.unwrap_or(""),
+            &cv_json,
+        ]),
+    };
+    let resp = complete_cached(db, provider, req).await?;
+    let letter = parse_cover_letter(&resp.text);
