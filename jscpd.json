{
  "threshold": 5,
  "reporters": ["console", "json", "threshold"],
  "minLines": 10,
  "minTokens": 70,
  "format": ["javascript", "typescript", "tsx", "rust", "css"],
  "mode": "mild",
  "blame": false,
  "absolute": false,
  "output": "./reports/quality/jscpd",
  "ignorePattern": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/vendor/**",
    "**/third_party/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/*.min.*",
    "**/*.snap",
    "**/reports/**"
  ]
}
