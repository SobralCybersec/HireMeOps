# One-shot Northflank browser worker.
# Contains only direct cloud runtime, Patchright and headless Chromium.
# No Tauri, frontend, AI agent, Xvfb or persistent profile volume.

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-headless-shell \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PATCHRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    HIREMEOPS_CLOUD=1 \
    HIREMEOPS_DISABLE_CAPTURE=1 \
    HIREMEOPS_CLOUD_BLOCK_HEAVY_RESOURCES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium-headless-shell \
      ca-certificates \
      dumb-init \
      fonts-liberation \
      fonts-noto-core \
      fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/automation
COPY automation/package.json automation/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY automation/ ./
RUN chown -R node:node /app

USER node
ENTRYPOINT ["dumb-init", "--", "node", "--max-old-space-size=96", "cloud-runner.mjs"]
